# Copy to .env.local and fill in real values. Never commit .env.local.

# --- Supabase ---
# Safe to expose to the browser (NEXT_PUBLIC_*)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only. Bypasses RLS — never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=
# Postgres DB password, used only by the Supabase CLI (migrations) — not read by the app.
SUPABASE_DB_PASSWORD=

# --- App ---
# Public origin used to build the deep links inside outbound WhatsApp
# messages. Must be the real deployed origin — a wrong value ships dead
# links to real phones. Defaults to the production URL if unset.
NEXT_PUBLIC_SITE_URL=https://car-auto-app.vercel.app

# Shared secret for the Vercel Cron routes (/api/cron/*). Any long random
# string; the routes reject requests without `Authorization: Bearer <this>`.
CRON_SECRET=

# --- Twilio WhatsApp (server-only) ---
# Account SID (AC...) and the account Auth Token. The Auth Token is also
# what the inbound webhook and status callback use to verify the
# X-Twilio-Signature header, so signature checks break without it.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# WhatsApp sender, in E.164 with the channel prefix, e.g. whatsapp:+14155238886
TWILIO_WHATSAPP_FROM=

# Content API template SIDs (HX...), one per message type and language.
# Register these in the Twilio Content Template Builder first. Each template
# must END with a link variable — WhatsApp is send-only, so the message
# points the user at the website instead of asking for a reply. Variable
# order must match lib/messaging/templates.ts:
#   odometer_request -> {{1}} vehicle, {{2}} link
#   service_due      -> {{1}} vehicle, {{2}} service, {{3}} link
TWILIO_CONTENT_SID_ODOMETER_REQUEST_AR=
TWILIO_CONTENT_SID_ODOMETER_REQUEST_EN=
TWILIO_CONTENT_SID_SERVICE_DUE_AR=
TWILIO_CONTENT_SID_SERVICE_DUE_EN=
