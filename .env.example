# Copy to .env.local and fill in real values. Never commit .env.local.

# --- Supabase ---
# Safe to expose to the browser (NEXT_PUBLIC_*)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only. Bypasses RLS — never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=
# Postgres DB password, used only by the Supabase CLI (migrations) — not read by the app.
SUPABASE_DB_PASSWORD=

# --- Clerk (auth) ---
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
# Server-only — never prefix with NEXT_PUBLIC_.
CLERK_SECRET_KEY=
# Custom sign-in/sign-up pages (components/auth/*), not Clerk's hosted ones.
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/login
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/signup
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/dashboard

# --- Telegram bot (server-only) ---
# From @BotFather (/newbot). The username is without the leading @.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# Random string; sent by Telegram in X-Telegram-Bot-Api-Secret-Token on every
# webhook call. Generate with: openssl rand -hex 32
TELEGRAM_WEBHOOK_SECRET=

# --- App ---
# Public origin used in message links (defaults to the Vercel production URL).
APP_BASE_URL=
# Bearer token Vercel Cron sends to /api/cron/*. Generate with: openssl rand -hex 32
CRON_SECRET=
