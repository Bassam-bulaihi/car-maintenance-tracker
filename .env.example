# Copy to .env.local and fill in real values. Never commit .env.local.

# --- Supabase ---
# Safe to expose to the browser (NEXT_PUBLIC_*)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only. Bypasses RLS — never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=
# Postgres DB password, used only by the Supabase CLI (migrations) — not read by the app.
SUPABASE_DB_PASSWORD=

# --- Meta WhatsApp Cloud API (server-only) ---
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
